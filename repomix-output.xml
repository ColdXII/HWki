        <div className="mt-3 rounded-xl bg-secondary/40 p-3 text-xs">
          <div className="flex items-center justify-between gap-2">
            <p className="text-sm font-semibold">{weapon.unique.name}</p>
            <div className="flex gap-1">
              {[1, 2, 3, 4, 5].map((d) => (
