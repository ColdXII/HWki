// Every grade a unit can be upgraded to
export const GRADES = [
  "B",
  "A",
  "S",
  "SS",
  "EX",
  "EX1",
  "EX2",
  "EX3",
  "EX4",
  "EX5",
  "EX6",
] as const;
export type Grade = (typeof GRADES)[number];

export type SkinSource = {
  type: "shop" | "battlepass" | "event" | "exchange" | "story" | "other";
  price?: number;
  label?: string;
  available?: boolean;
  note?: string;
};

export type Skin = {
  id: string;
  name: string;
  portrait?: string;
  fullBody: string;
  fullBodyCensored?: string;
  limited?: boolean;
  sources?: SkinSource[];
  pv?: PvLink[];
};

export type StigmaSetData = Omit<StigmaSet, "grade">;

export type StatBlock = {
  str: number;
  tec: number;
  int: number;
  vit: number;
  agi: number;
  meleeAtk: number;
  rangedAtk: number;
  magicAtk: number;
  allAtk: number;
  maxHp: number;
  spd: number;
  startAp: number;
  apRecovery: number;
  accuracy: number;
