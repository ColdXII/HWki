  critDmg: number;
  slashBoost: number;
  pierceBoost: number;
  crushBoost: number;
  heatBoost: number;
  coldBoost: number;
  electricBoost: number;
  immaterialBoost: number;
  poisonBoost: number;
  elementalBoost: number;
  slashDef: number;
  pierceDef: number;
  crushDef: number;
  heatDef: number;
  coldDef: number;
  electricDef: number;
  immaterialDef: number;
  poisonDef: number;
  blockChance: number;
};

export const elementalBoost = [
  "slashBoost",
  "pierceBoost",
  "crushBoost",
  "heatBoost",
  "coldBoost",
  "electricBoost",
