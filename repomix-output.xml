  "knockbackRes",
  "nonAttrDef",
  "slashBoost",
  "pierceBoost",
  "crushBoost",
  "heatBoost",
  "coldBoost",
  "electricBoost",
  "poisonBoost",
  "immaterialBoost",
  "elementalBoost",

  "slashDef",
  "pierceDef",
  "crushDef",
  "heatDef",
  "coldDef",
  "electricDef",
  "poisonDef",
  "immaterialDef",
  "physicalDef",
  "elementsDef",
  "allDef",

  "basicAttackDmg",
