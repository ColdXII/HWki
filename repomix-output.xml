] as const;
export type StatKey = (typeof STAT_KEYS)[number];

export type TraitEffect = {
  stat: StatKey;
  type: "flat" | "percent"; 
  value: number;
  battleOnly?: boolean;
  condition?: "maxAffection";
  maxStacks?: number;
  stackKey?: string;
  stackLabel?: string;
};

export type Trait = {
  id: string;
  name: string;
  kind: "unique" | "general";
  grade?: number;
  category?: string[];
  categories?: string[];
  icon?: string;
  description?: string;
  effects: TraitEffect[];
  flavor?: string;
};

export type GradeStats = { lv1: StatBlock; lv60: StatBlock };

export type BasicKey = "str" | "tec" | "int" | "vit" | "agi";
export type BasicStats = Record<BasicKey, number>;

export type CharacterDetails = {
  basic?: BasicStats;

  gradeGains?: Partial<Record<Grade, Partial<BasicStats>>>;

  traits?: string[];

  manual?: {
    spd?: number;
