<file path="src/app/gifts/page.tsx">
"use client";

import { useState } from "react";
import { Crown, Gift, Search, Star } from "lucide-react";
import { characters } from "@/data/characters";
import { getDetails } from "@/data/details";
import { gifts, getGift } from "@/data/gifts";
import { asset } from "@/lib/asset";
import { GIFT_GRADES, GIFT_RANGE, type GiftGrade } from "@/data/types";

// Tile colors for each gift grade
const TILE: Record<GiftGrade, string> = {
  gray: "border-zinc-500/40 from-zinc-500/25 shadow-zinc-500/10",
  green: "border-emerald-500/50 from-emerald-500/25 shadow-emerald-500/20",
  blue: "border-blue-500/50 from-blue-500/25 shadow-blue-500/20",
  purple: "border-purple-500/50 from-purple-500/25 shadow-purple-500/20",
  yellow: "border-amber-400/60 from-amber-400/25 shadow-amber-400/25",
};
const DOT: Record<GiftGrade, string> = {
  gray: "bg-zinc-400",
  green: "bg-emerald-400",
  blue: "bg-blue-400",
  purple: "bg-purple-400",
  yellow: "bg-amber-300",
};

// The three tips at the top
const TIPS = [
  {
    icon: Gift,
    title: "Gift boxes",
    text: "Normal gifts come from boxes. The top box gives purple to yellow gifts, so picking a purple one is never worth it.",
  },
  {
    icon: Crown,
    title: "Always grab the Tiara",
    text: "Pick it whenever it shows up.",
  },
  {
    icon: Star,
    title: "Best value",
    text: "The star marks the top value of the gift: high value for lower quantity.",
  },
];

// Bold on your sheet = the top of the grade's range for a cheap gift.
// Only gray and green are confirmed, so only those two count.
const isBest = (grade: GiftGrade, value: number) =>
  grade !== "purple" && value === GIFT_RANGE[grade].max;

// Gift icon: shows the first letter if the file is missing
function GiftImg({ src, name }: { src?: string; name: string }) {
  const [failed, setFailed] = useState(false);
  if (!src || failed) {
    return (
      <span className="text-3xl font-bold text-muted-foreground/40">
        {name.charAt(0)}
      </span>
    );
  }
  return (
    <img 
      src={asset(src)}
      alt={name}
      onError={() => setFailed(true)}
      className="h-full w-full object-contain p-2 drop-shadow-[0_4px_8px_rgba(0,0,0,0.6)]"
    />
  );
}

export default function GiftsPage() {
  const [search, setSearch] = useState("");
  const q = search.toLowerCase();

  // Characters that have gifts, filtered by the search (character or gift name)
  const rows = characters
    .map((c) => ({ c, liked: getDetails(c.id).gifts ?? [] }))
    .filter(({ liked }) => liked.length > 0)
    .filter(
      ({ c, liked }) =>
        c.name.toLowerCase().includes(q) ||
        liked.some((l) => getGift(l.gift)?.name.toLowerCase().includes(q)),
    );

  const withGifts = characters.filter(
    (c) => (getDetails(c.id).gifts ?? []).length > 0,
  ).length;

  return (
    <div className="space-y-6">
      {/* ===== HEADER ===== */}
      <div className="flex flex-wrap items-center justify-between gap-4 rounded-3xl border border-border bg-gradient-to-br from-primary/20 via-card/60 to-card/30 p-6">
        <div className="flex items-center gap-4">
          <span className="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/20 text-primary">
            <Gift className="h-7 w-7" />
          </span>
          <div>
            <h1 className="text-3xl font-bold tracking-tight">Gifts</h1>
            <p className="text-sm text-muted-foreground">
              Which gifts each character likes, and what they are worth.
            </p>
          </div>
        </div>
        <div className="flex gap-2 text-xs">
          <span className="rounded-full border border-border bg-black/30 px-3 py-1.5">
            <b className="text-sm">{withGifts}</b> characters
          </span>
          <span className="rounded-full border border-border bg-black/30 px-3 py-1.5">
            <b className="text-sm">{gifts.length}</b> gifts
          </span>
        </div>
      </div>

      {/* ===== TIPS ===== */}
      <div className="grid gap-3 md:grid-cols-3">
        {TIPS.map((t) => (
          <div
            key={t.title}
            className="flex gap-3 rounded-2xl border border-border bg-card/60 p-4"
          >
            <span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-primary/15 text-primary">
              <t.icon className="h-4 w-4" />
            </span>
            <div>
              <p className="text-sm font-semibold">{t.title}</p>
              <p className="mt-0.5 text-xs leading-relaxed text-muted-foreground">
                {t.text}
              </p>
            </div>
          </div>
        ))}
      </div>

      {/* ===== GRADE LEGEND ===== */}
      <div className="flex flex-wrap gap-2">
        {GIFT_GRADES.map((g) => (
          <span
            key={g}
            className="flex items-center gap-2 rounded-full border border-border bg-card/60 px-3 py-1.5 text-xs"
          >
            <span
              className={`h-2.5 w-2.5 rounded-full shadow-[0_0_8px] shadow-current ${DOT[g]}`}
            />
            <span className="font-semibold capitalize">{g}</span>
            <span className="tabular-nums text-muted-foreground">
              {GIFT_RANGE[g].min} to {GIFT_RANGE[g].max}
            </span>
          </span>
        ))}
      </div>

      {/* ===== SEARCH ===== */}
      <div className="relative max-w-md">
        <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
        <input
          value={search}
          onChange={(e) => setSearch(e.target.value)}
          placeholder="Search a character or a gift..."
          className="h-10 w-full rounded-xl border border-border bg-card/60 pl-9 pr-3 text-sm outline-none focus:border-primary/60"
        />
      </div>

      {/* ===== ONE CARD FOR EACH CHARACTER ===== */}
      <div className="space-y-4">
        {rows.map(({ c, liked }) => (
          <div
            key={c.id}
            className="overflow-hidden rounded-3xl border border-border bg-card/60"
          >
            <div className="flex flex-col sm:flex-row">
              {/* Character */}
              <div className="flex shrink-0 items-center gap-4 bg-gradient-to-br from-primary/20 to-transparent p-4 sm:w-56 sm:flex-col sm:items-start">
                {c.portrait ? (
                  <img
                    src={asset(c.portrait)}
                    alt={c.name}
                    className="h-35 w-35 rounded-2xl object-cover object-top ring-2 ring-white/10"
                  />
                ) : (
                  <div className="flex h-28 w-24 items-center justify-center rounded-2xl bg-black/30 text-3xl font-bold text-muted-foreground/40">
                    {c.name.charAt(0)}
                  </div>
                )}
                <div className="leading-tight">
                  <p className="text-lg font-bold">{c.name}</p>
                  <p className="text-xs text-muted-foreground">{c.title}</p>
                  <p className="mt-2 text-[11px] uppercase tracking-wider text-muted-foreground"></p>
                </div>
              </div>

              {/* Gifts */}
              <div className="flex flex-1 flex-wrap content-start gap-4 p-5">
                {liked.map((l) => {
                  const gift = getGift(l.gift);
                  if (!gift)
                    return (
                      <span key={l.gift} className="text-xs text-rose-300">
                        Missing: {l.gift}
                      </span>
                    );
                  const range = GIFT_RANGE[gift.grade];
                  const outOfRange = l.value < range.min || l.value > range.max;
                  const best = isBest(gift.grade, l.value);
                  return (
                    <div
                      key={l.gift}
                      className="w-30 text-center transition hover:-translate-y-1"
                    >
                      <div
                        className={`relative flex h-30 items-center justify-center rounded-2xl border bg-gradient-to-b to-black/40 shadow-lg ${TILE[gift.grade]}`}
                      >
                        <GiftImg
                          src={asset(gift.icon ?? `/gifts/${gift.id}.webp`)}
                          name={gift.name}
                        />
                        {/* Value */}
                        <span
                          className={`absolute -right-2 -top-2 flex h-7 min-w-7 items-center justify-center rounded-full border px-1.5 text-xs font-bold tabular-nums ${
                            outOfRange
                              ? "border-rose-400 bg-rose-950 text-rose-300"
                              : "border-white/20 bg-black/85 text-white"
                          }`}
                        >
                          {l.value}
                        </span>
                        {best && (
                          <Star className="absolute left-1.5 top-1.5 h-4 w-4 fill-amber-300 text-amber-300 drop-shadow" />
                        )}
                      </div>
                      <p
                        className={`mt-2 text-[11px] leading-tight ${best ? "font-bold text-foreground" : "text-foreground/80"}`}
                      >
                        {gift.name}
                      </p>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        ))}
      </div>

      {rows.length === 0 && (
        <p className="py-16 text-center text-muted-foreground">
          Nothing found.
        </p>
      )}
    </div>
  );
}
</file>

<file path="src/app/stigma/page.tsx">
"use client";

import { useState } from "react";
import { Gem, Search } from "lucide-react";
import { stigmaSets } from "@/data/stigmas";
import {
  STIGMA_MAX_LEVEL,
  type StigmaGrade,
  type StigmaSlot,
} from "@/data/types";
import { asset } from "@/lib/asset";
import { STAT_LABEL, label } from "@/lib/stat-labels";

const SLOTS: StigmaSlot[] = ["top", "left", "bottom", "right"];

const num = (n: number) => String(Number(n.toFixed(1)));

// Colors for each grade
const BADGE: Record<StigmaGrade, string> = {
  SS: "border-purple-500/50 bg-purple-500/15 text-purple-300",
  EX: "border-amber-500/50 bg-amber-500/15 text-amber-300",
};
const CARD: Record<StigmaGrade, string> = {
  SS: "border-purple-500/30 from-purple-500/10",
  EX: "border-amber-500/30 from-amber-500/10",
};
const GLOW: Record<StigmaGrade, string> = {
  SS: "from-purple-500/25",
  EX: "from-amber-500/25",
};

// Image that shows the first letter of the slot if the file is missing
function PieceImg({
  src,
  alt,
  slot,
}: {
  src?: string;
  alt: string;
  slot: string;
}) {
  const [failed, setFailed] = useState(false);
  if (!src || failed) {
    return (
      <span className="text-3xl font-bold uppercase text-muted-foreground/30">
        {slot.charAt(0)}
      </span>
    );
  }
  return (
    <img 
      src={asset(src)}
      alt={alt}
      onError={() => setFailed(true)}
      className="h-20 w-20 object-contain drop-shadow-[0_6px_12px_rgba(0,0,0,0.7)] transition group-hover:scale-110"
    />
  );
}

export default function StigmaPage() {
  const [search, setSearch] = useState("");
  const [grade, setGrade] = useState<StigmaGrade | "all">("all");

  const q = search.toLowerCase();

  // EX first, then SS, then by name
  const shown = stigmaSets
    .filter(
      (s) =>
        (grade === "all" || s.grade === grade) &&
        `${s.name} ${s.twoSet.description} ${s.fourSet.description}`
          .toLowerCase()
          .includes(q),
    )
    .sort((a, b) =>
      a.grade === b.grade
        ? a.name.localeCompare(b.name)
        : a.grade === "EX"
          ? -1
          : 1,
    );

  const count = (g: StigmaGrade) =>
    stigmaSets.filter((s) => s.grade === g).length;

  return (
    <div className="space-y-6">
      {/* ===== HEADER ===== */}
      <div className="flex flex-wrap items-center justify-between gap-4 rounded-3xl border border-border bg-gradient-to-br from-primary/20 via-card/60 to-card/30 p-6">
        <div>
          <h1 className="text-3xl font-bold tracking-tight">Stigma</h1>
          <p className="text-sm text-muted-foreground">
            Sets, main stats and set bonuses.
          </p>
        </div>
        <span className="rounded-full border border-border bg-black/30 px-3 py-1.5 text-xs">
          <b className="text-sm">{stigmaSets.length}</b> sets
        </span>
      </div>

      {/* ===== SEARCH AND GRADE FILTER ===== */}
      <div className="flex flex-wrap items-center justify-between gap-4">
        <div className="relative w-full max-w-md">
          <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
          <input
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            placeholder="Search a set or a bonus..."
            className="h-10 w-full rounded-xl border border-border bg-card/60 pl-9 pr-3 text-sm outline-none focus:border-primary/60"
          />
        </div>

        <div className="flex items-center gap-2">
          <button
            onClick={() => setGrade("all")}
            className={`rounded-full border px-4 py-1.5 text-sm transition ${
              grade === "all"
                ? "border-primary/70 bg-primary/15 text-primary"
                : "border-border bg-secondary hover:bg-accent"
            }`}
          >
            All{" "}
            <span className="text-xs text-muted-foreground">
              {stigmaSets.length}
            </span>
          </button>
          {(["EX", "SS"] as const).map((g) => (
            <button
              key={g}
              onClick={() => setGrade(grade === g ? "all" : g)}
              className={`rounded-full border px-4 py-1.5 text-sm transition ${
                grade === g
                  ? BADGE[g]
                  : "border-border bg-secondary hover:bg-accent"
              }`}
            >
              {g} <span className="text-xs opacity-70">{count(g)}</span>
            </button>
          ))}
        </div>
      </div>

      {/* ===== SETS ===== */}
      <div className="grid gap-4 lg:grid-cols-2">
        {shown.map((set) => (
          <div
            key={set.id}
            className={`space-y-4 rounded-3xl border bg-gradient-to-b to-card/40 p-4 ${CARD[set.grade]}`}
          >
            <div className="flex items-center justify-between gap-3">
              <p className="text-lg font-bold leading-tight">{set.name}</p>
              <span
                className={`shrink-0 rounded-md border px-2 py-0.5 text-xs font-bold ${BADGE[set.grade]}`}
              >
                {set.grade}
              </span>
            </div>

            {/* The four pieces */}
            <div className="grid grid-cols-2 gap-2 sm:grid-cols-4">
              {SLOTS.map((slot) => {
                const main = set.pieces[slot].mainStat;
                const v = main.value[set.grade];
                const stats = Array.isArray(main.stat)
                  ? main.stat
                  : [main.stat];
                return (
                  <div
                    key={slot}
                    className="group flex flex-col items-center overflow-hidden rounded-2xl border border-border/60 bg-black/30 text-center"
                  >
                    <div
                      className={`flex h-24 w-full items-center justify-center bg-gradient-to-b to-transparent ${GLOW[set.grade]}`}
                    >
                      <PieceImg
                        src={asset(
                          set.pieces[slot].icon ??
                          `/stigmas/${set.id}-${slot}.webp`
                        )}
                        alt={`${set.name} ${slot}`}
                        slot={slot}
                      />
                    </div>
                    <div className="w-full space-y-0.5 px-2 pb-2.5 pt-1.5">
                      <p className="text-[10px] uppercase tracking-wider text-muted-foreground">
                        {slot}
                      </p>
                      <p className="text-xs font-semibold leading-tight text-primary">
                        {stats.map(label).join(" & ")}
                      </p>
                      <p className="text-[11px] font-medium tabular-nums text-amber-300">
                        {v
                          ? `${num(v.lv1)} → ${num(v.lv25)}${main.type === "percent" ? "%" : ""}`
                          : "No data"}
                      </p>
                    </div>
                  </div>
                );
              })}
            </div>
            <p className="-mt-2 text-[11px] text-muted-foreground">
              Main stat from Lv 1 to Lv {STIGMA_MAX_LEVEL}
            </p>

            {/* Set bonuses */}
            <div className="space-y-2">
              {[
                { need: 2, text: set.twoSet.description },
                { need: 4, text: set.fourSet.description },
              ].map((r) => (
                <div
                  key={r.need}
                  className="flex gap-3 rounded-xl bg-black/25 p-3"
                >
                  <span className="flex h-fit shrink-0 items-center rounded-md bg-emerald-500/20 px-2 py-1 text-[10px] font-bold text-emerald-300">
                    {r.need} SET
                  </span>
                  <span className="text-xs whitespace-pre-line leading-relaxed text-foreground/85">
                    {r.text}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      {shown.length === 0 && (
        <p className="py-16 text-center text-muted-foreground">
          No sets found.
        </p>
      )}
    </div>
  );
}
</file>

<file path="src/app/traits/page.tsx">
"use client";

import { memo, useMemo, useState } from "react";
import { traits } from "@/data/traits";
import type { Trait, TraitEffect } from "@/data/types";
import { label } from "@/lib/stat-labels";
import { asset } from "@/lib/asset";

const PAGE_SIZE = 60;

// ===== helpers (module scope — run once) =====

const fmtEffect = (e: TraitEffect) =>
  `${label(e.stat)} ${e.value > 0 ? "+" : ""}${Number(e.value.toFixed(1))}${
    e.type === "percent" ? "%" : ""
  }`;

/** Map a stat key to a filter category chip */
const STAT_GROUP: Record<string, string> = {
  str: "Basic Stats",
  tec: "Basic Stats",
  int: "Basic Stats",
  vit: "Basic Stats",
  agi: "Basic Stats",
  meleeAtk: "Melee ATK",
  rangedAtk: "Ranged ATK",
  magicAtk: "Magic ATK",
  allAtk: "All ATK",
  maxHp: "Max HP",
  spd: "SPD",
  accuracy: "Accuracy",
  evade: "Evade",
  startAp: "Starting AP",
  apRecovery: "AP Recovery",
  critRate: "Crit Rate",
  critDmg: "Crit DMG",
  slashBoost: "Slash Boost",
  pierceBoost: "Pierce Boost",
  crushBoost: "Crush Boost",
  heatBoost: "Heat Boost",
  coldBoost: "Cold Boost",
  electricBoost: "Electric Boost",
  immaterialBoost: "Immaterial Boost",
  poisonBoost: "Poison Boost",
  elementalBoost: "Elemental Boost",
  basicAttackDmg: "Basic Attack DMG",
  combatSkillDmg: "Combat Skill DMG",
  additionalDmgBoost: "Additional DMG Boost",
  responseDmg: "Response DMG",
  counterattackDmg: "Counterattack DMG",
  supportAtkDmg: "Support Attack DMG",
  supportAttackDmg: "Support Attack DMG",
  supportCounterattackDmg: "Support Counterattack DMG",
  finalDmg: "Final DMG",
  slashDef: "Slash DEF",
  pierceDef: "Pierce DEF",
  crushDef: "Crush DEF",
  heatDef: "Heat DEF",
  coldDef: "Cold DEF",
  electricDef: "Electric DEF",
  immaterialDef: "Immaterial DEF",
  poisonDef: "Poison DEF",
  formationCost: "Formation Cost",
  aggroAdj: "Aggro Adjustment",
  knockbackRes: "Knockback Resistance",
  knockbackResistance: "Knockback Resistance",
  allDef: "All DEF",
  blockChance: "Block Chance",
};

const groupOf = (stat: string) =>
  STAT_GROUP[stat] ??
  (stat.endsWith("Boost") ? "Boost" : stat.endsWith("Def") ? "Defense" : null);

const categoriesOf = (t: Trait): string[] => {
  const set = new Set<string>([...(t.categories ?? []), ...(t.category ?? [])]);
  for (const e of t.effects) {
    const g = groupOf(e.stat);
    if (g) set.add(g);
  }
  return [...set];
};

/** Trim each line of a multiline description once */
const cleanDesc = (d?: string) =>
  d
    ?.split("\n")
    .map((l) => l.trim())
    .filter(Boolean)
    .join("\n") ?? "";

// Precompute once — `traits` is a static module export
const CATS_BY_ID = new Map(traits.map((t) => [t.id, categoriesOf(t)] as const));
const DESC_BY_ID = new Map(
  traits.map((t) => [t.id, cleanDesc(t.description)] as const),
);
const SEARCH_BY_ID = new Map(
  traits.map(
    (t) => [t.id, `${t.name} ${t.description ?? ""}`.toLowerCase()] as const,
  ),
);
const USED_GRADES = [
  ...new Set(traits.map((t) => t.grade).filter((g): g is number => g != null)),
].sort((a, b) => a - b);
const toggle = <T,>(list: T[], set: (v: T[]) => void, v: T) =>
  set(list.includes(v) ? list.filter((x) => x !== v) : [...list, v]);

const chipClass = (on: boolean) =>
  `rounded-full border px-3 py-1 text-sm capitalize transition ${
    on
      ? "border-primary/70 bg-primary/15 text-primary"
      : "border-border bg-secondary hover:bg-accent"
  }`;

// ===== UI pieces =====

function TraitImg({
  id,
  icon,
  name,
}: {
  id: string;
  icon?: string;
  name: string;
}) {
  const [failed, setFailed] = useState(false);
  if (failed) {
    return (
      <span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-black/30 text-sm font-bold text-muted-foreground/50">
        {name.charAt(0)}
      </span>
    );
  }
  return (
    <img
      src={asset(icon ?? `/traits/${id}.webp`)}
      alt=""
      onError={() => setFailed(true)}
      className="h-9 w-9 shrink-0 rounded-lg bg-black/30 object-contain p-0.5"
    />
  );
}

const TraitCard = memo(function TraitCard({ t }: { t: Trait }) {
  const cats = CATS_BY_ID.get(t.id);
  const desc = DESC_BY_ID.get(t.id);

  return (
    <div className="rounded-2xl border border-border bg-card/60 p-4">
      <div className="flex items-start justify-between gap-2">
        <div className="flex min-w-0 items-center gap-2">
          <TraitImg id={t.id} icon={t.icon} name={t.name} />
          <p className="text-sm font-semibold">{t.name}</p>
        </div>
        <div className="flex shrink-0 gap-1.5">
          {t.grade != null && (
            <span className="rounded bg-amber-500/15 px-1.5 py-0.5 text-[10px] font-bold text-amber-300">
              G{t.grade}
            </span>
          )}
          <span
            className={`rounded px-1.5 py-0.5 text-[10px] font-semibold uppercase ${
              t.kind === "unique"
                ? "bg-primary/15 text-primary"
                : "bg-secondary text-muted-foreground"
            }`}
          >
            {t.kind}
          </span>
        </div>
      </div>

      {cats && cats.length > 0 && (
        <div className="mt-1.5 flex flex-wrap gap-1">
          {cats.map((c) => (
            <span
              key={c}
              className="rounded bg-secondary px-1.5 py-0.5 text-[10px] text-muted-foreground"
            >
              {c}
            </span>
          ))}
        </div>
      )}

      {desc ? (
        <p className="mt-2 whitespace-pre-line text-xs leading-relaxed text-muted-foreground">
          {desc}
        </p>
      ) : (
        <ul className="mt-2 space-y-1 text-xs text-muted-foreground">
          {t.effects.map((e, i) => (
            <li
              key={i}
              className="flex flex-wrap items-center gap-x-1.5 gap-y-0.5"
            >
              <span className="whitespace-nowrap">{fmtEffect(e)}</span>
              {e.battleOnly && (
                <span className="whitespace-nowrap text-[10px] text-sky-300">
                  (battle)
                </span>
              )}
              {e.condition === "maxAffection" && (
                <span className="whitespace-nowrap text-[10px] text-pink-300">
                  (max affection)
                </span>
              )}
              {e.condition && e.condition !== "maxAffection" && (
                <span className="whitespace-nowrap text-[10px] text-pink-300">
                  ({e.condition})
                </span>
              )}
            </li>
          ))}
          {t.effects.length === 0 && <li>No stat effects.</li>}
        </ul>
      )}
    </div>
  );
});

// ===== page =====

export default function TraitsPage() {
  const [search, setSearch] = useState("");
  const [kind, setKind] = useState("all");
  const [grades, setGrades] = useState<number[]>([]);
  const [cats, setCats] = useState<string[]>([]);
  const [limit, setLimit] = useState(PAGE_SIZE);

  const q = search.trim().toLowerCase();

  // Traits matching search / kind / grade (category filter applied separately for the list)
  const basePool = useMemo(() => {
    const gradeSet = grades.length ? new Set(grades) : null;
    return traits.filter((t) => {
      if (kind !== "all" && t.kind !== kind) return false;
      if (gradeSet && (t.grade == null || !gradeSet.has(t.grade))) return false;
      if (q && !(SEARCH_BY_ID.get(t.id) ?? "").includes(q)) return false;
      return true;
    });
  }, [q, kind, grades]);

  // Category chip counts: respect search / kind / grade and other selected categories (AND).
  // Count for chip C = traits that have C and every currently selected category.
  const catCounts = useMemo(() => {
    const names = new Set<string>();
    for (const t of basePool) {
      for (const c of CATS_BY_ID.get(t.id) ?? []) names.add(c);
    }
    // Always keep selected chips visible even if count drops to 0
    for (const c of cats) names.add(c);

    const entries: [string, number][] = [];
    for (const c of names) {
      // Must include this chip's category + all selected ones
      const need = cats.includes(c) ? cats : [...cats, c];
      let n = 0;
      for (const t of basePool) {
        const list = CATS_BY_ID.get(t.id);
        if (list && need.every((x) => list.includes(x))) n++;
      }
      if (n > 0 || cats.includes(c)) entries.push([c, n]);
    }
    return entries.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
  }, [basePool, cats]);

  const shown = useMemo(() => {
    const catNeed = cats.length ? cats : null;
    const filtered = catNeed
      ? basePool.filter((t) => {
          const traitCats = CATS_BY_ID.get(t.id);
          return !!traitCats && catNeed.every((c) => traitCats.includes(c));
        })
      : basePool;
    return [...filtered].sort((a, b) =>
      a.kind === b.kind
        ? a.name.localeCompare(b.name)
        : a.kind === "general"
          ? -1
          : 1,
    );
  }, [basePool, cats]);

  // Reset pagination when filters change (derive next limit in the same update)
  const setKindAndReset = (k: string) => {
    setKind(k);
    setLimit(PAGE_SIZE);
  };
  const toggleGrade = (g: number) => {
    toggle(grades, setGrades, g);
    setLimit(PAGE_SIZE);
  };
  const toggleCat = (c: string) => {
    toggle(cats, setCats, c);
    setLimit(PAGE_SIZE);
  };
  const onSearch = (value: string) => {
    setSearch(value);
    setLimit(PAGE_SIZE);
  };
  const clearFilters = () => {
    setKind("all");
    setGrades([]);
    setCats([]);
    setLimit(PAGE_SIZE);
  };

  const hasFilters = kind !== "all" || grades.length > 0 || cats.length > 0;
  const visible = shown.slice(0, limit);

  return (
    <div className="space-y-6">
      {/* Filters */}
      <div className="space-y-3 rounded-2xl border border-border bg-card/60 p-4">
        <div className="flex flex-wrap items-center gap-2">
          <span className="w-20 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
            Kind
          </span>
          {(["all", "general", "unique"] as const).map((k) => (
            <button
              key={k}
              type="button"
              onClick={() => setKindAndReset(k)}
              className={chipClass(kind === k)}
            >
              {k}
            </button>
          ))}
        </div>

        {USED_GRADES.length > 0 && (
          <div className="flex flex-wrap items-center gap-2 border-t border-border/60 pt-3">
            <span className="w-20 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
              Grade
            </span>
            {USED_GRADES.map((g) => (
              <button
                key={g}
                type="button"
                onClick={() => toggleGrade(g)}
                className={chipClass(grades.includes(g))}
              >
                {g}
              </button>
            ))}
          </div>
        )}

        <div className="flex items-start gap-2 border-t border-border/60 pt-3">
          <span className="w-20 shrink-0 pt-1.5 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
            Category
          </span>
          <div className="flex flex-1 flex-wrap gap-2">
            {catCounts.map(([c, n]) => (
              <button
                key={c}
                type="button"
                onClick={() => toggleCat(c)}
                className={chipClass(cats.includes(c))}
              >
                {c} <span className="text-xs opacity-60">{n}</span>
              </button>
            ))}
          </div>
        </div>

        {hasFilters && (
          <button
            type="button"
            onClick={clearFilters}
            className="text-xs text-muted-foreground underline hover:text-foreground"
          >
            Clear filters
          </button>
        )}
      </div>

      <div className="flex items-center justify-between gap-4">
        <input
          value={search}
          onChange={(e) => onSearch(e.target.value)}
          placeholder="Search traits..."
          className="h-10 w-full max-w-md rounded-md border border-border bg-card/60 px-3 text-sm outline-none focus:border-primary/60"
        />
        <span className="text-sm text-muted-foreground">
          {shown.length} of {traits.length}
        </span>
      </div>

      <div className="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
        {visible.map((t) => (
          <TraitCard key={t.id} t={t} />
        ))}
      </div>

      {shown.length > limit && (
        <div className="flex justify-center">
          <button
            type="button"
            onClick={() => setLimit((n) => n + PAGE_SIZE)}
            className="rounded-full border border-border bg-secondary px-6 py-2 text-sm hover:bg-accent"
          >
            Show more ({shown.length - limit} left)
          </button>
        </div>
      )}

      {shown.length === 0 && (
        <p className="py-16 text-center text-muted-foreground">
          No traits found.
        </p>
      )}
    </div>
  );
}
